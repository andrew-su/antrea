ARG GO_VERSION
FROM nsx-ujo-docker-local.packages.vcfd.broadcom.net/antrea/golang:${GO_VERSION} as antrea-idps-build

WORKDIR /antrea

COPY go.mod /antrea/go.mod

RUN go mod download

COPY . /antrea

RUN make antrea-idps-agent antrea-idps-controller antrea-idps-agent-instr-binary antrea-idps-controller-instr-binary

FROM nsx-ujo-docker-local.packages.vcfd.broadcom.net/antrea/debian:12.5

LABEL maintainer="Antrea <projectantrea-dev@googlegroups.com>"
LABEL description="The docker image for the Antrea IDPS with code coverage measurement enabled for testing purposes."

USER root

COPY --from=antrea-idps-build /antrea/bin/antrea-idps-* /usr/local/bin/
COPY --from=antrea-idps-build /antrea/test/e2e/coverage/idps-* /
