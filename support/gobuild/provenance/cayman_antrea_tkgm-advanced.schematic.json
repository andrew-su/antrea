{
    "schema_id": "1.1",
    "order": 1,
    "spdx_templates": {
        "spdx": {
            "package": {
                "license_declared": "Broadcom_Proprietary",
                "originator": "Organization: Broadcom, Inc.",
                "supplier": "Organization: Broadcom, Inc.",
                "home_page": "https://github-vcf.devops.broadcom.net/vcf/cayman_antrea",
                "short_summary": "cayman antrea tkgm advanced",
                "detailed_description": "",
                "version": "2.2"
            }
        }
    },
    "scanner_instances": {
        "go": {
            "scanner": "srpcli-go",
            "args": ["--go-mod=$(gobuild:buildroot)/cayman_antrea/antrea/src/go.mod", "--incorporated=true", "--usage=building"]
        },
        "syft": {
            "scanner": "srpcli-syft",
            "args": ["--scan-target=$(gobuild:buildroot)/publish/","--incorporated=true", "--usage=functionality"]
        }
    },
    "input_templates": {
        "comps-common": {
            "$(gobuild:gobuild_component_cayman_uid)": {
                "incorporated": false,
                "usages": ["building"]
            },
            "$(gobuild:gobuild_component_cayman_go_uid)": {
                "incorporated": false,
                "usages": ["building"]
            },
            "$(gobuild:gobuild_component_cayman_openssl_uid)": {
                "incorporated": false,
                "usages": ["building"]
            },
            "$(gobuild:gobuild_component_cayman_python_uid)": {
                "incorporated": false,
                "usages": ["building"]
            },
            "$(gobuild:gobuild_component_cayman_helm_uid)": {
                "incorporated": false,
                "usages": ["building"]
            },
            "$(gobuild:gobuild_component_cayman_kubernetes_sigs_kustomize_uid)": {
                "incorporated": false,
                "usages": ["building"]
            },
            "$(gobuild:gobuild_component_nsx_ovs_build_uid)": {
                "incorporated": true,
                "usages": ["building", "functionality"]
            },
            "$(gobuild:gobuild_component_cayman_suricata_uid)": {
                "incorporated": true,
                "usages": ["building", "functionality"]
            },
            "$(gobuild:gobuild_component_cayman_cni_plugins_uid)": {
                "incorporated": true,
                "usages": ["building", "functionality"]
            },
            "$(gobuild:gobuild_component_cayman_msvc_redists_uid)": {
                "incorporated": true,
                "usages": ["building", "functionality"]
            }
        }
    },
    "outputs": {
        "$(gobuild:publish_deliverable_uid)": {
            "scanner_instances": [{"name": "go"}, {"name": "syft"}],
            "merge_input_templates": ["comps-common"],
            "merge_spdx_template": "spdx",
            "product": {
                "distribution_type": "external",
                "embedded_in_hardware": false
            }
        },
        "$(gobuild:zip_deliverables_uid)": {
            "scanner_instances": [{"name": "go"}, {"name": "syft"}],
            "merge_input_templates": ["comps-common"],
            "merge_spdx_template": "spdx",
            "product": {
                "distribution_type": "external",
                "embedded_in_hardware": false
            }
        }
    }
}
