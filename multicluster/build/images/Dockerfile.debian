FROM dockerhub.artifactory.vcfd.broadcom.net/library/debian:bullseye-slim

ARG BUILD_INFO

LABEL maintainer="Antrea <projectantrea-dev@googlegroups.com>"
LABEL description="The Docker image to deploy the Antrea Multicluster controller."
LABEL build-info="${BUILD_INFO}"

COPY bin/antrea-mc-controller /

RUN echo "${BUILD_INFO}" > /build-info

